# Optional local-only. The deployed MCP reads none of these.
# Never commit real values.

# Speeds up `npm run ingest:shopify` for maintainers. Without it, ingest uses
# public storefront pages (slower / rate-limited). Not used at runtime.
SHOPIFY_STORE_DOMAIN=bakingsteel.com
SHOPIFY_ADMIN_TOKEN=

# Optional: branded connector URL on the landing page
# NEXT_PUBLIC_MCP_URL=https://bakingsteel-mcp.vercel.app/mcp

# CLI YouTube ingest only (`npm run ingest:youtube` uses yt-dlp)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCpG81Xa-wHu8P7s_RjzBaBg
