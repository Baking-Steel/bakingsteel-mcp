# Local / Vercel secrets — never commit real values.
# Production sets these on the Vercel project only (not in GitHub).

# Shopify Admin API — used by Vercel Cron to refresh recipes/articles into Blob.
# Also used by `npm run ingest:shopify` locally. Without it, the CLI falls back
# to rate-limited storefront scraping; the cron route requires this token.
SHOPIFY_STORE_DOMAIN=bakingsteel.com
SHOPIFY_ADMIN_TOKEN=

# Protects GET /api/cron/refresh. Vercel Cron sends Authorization: Bearer …
CRON_SECRET=

# Vercel Blob read/write token for the refreshed corpus.json
BLOB_READ_WRITE_TOKEN=

# Optional: branded connector URL shown on the landing page
# NEXT_PUBLIC_MCP_URL=https://bakingsteel-mcp.vercel.app/mcp

# YouTube — CLI ingest only (`npm run ingest:youtube` uses yt-dlp; these are
# unused by the deployed MCP unless you wire them later).
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCpG81Xa-wHu8P7s_RjzBaBg

# Optional local structuring during ingest experiments
ANTHROPIC_API_KEY=
