# All of these are ingest-time only. The deployed MCP server reads none of them —
# it serves the committed data/corpus.json and needs no secrets at runtime.

# Shopify Admin API. Optional but strongly preferred: without it the ingest
# falls back to scraping 298 storefront pages, which the store rate-limits.
SHOPIFY_STORE_DOMAIN=bakingsteel.com
SHOPIFY_ADMIN_TOKEN=

# YouTube. The API key lists videos; captions on an owned channel need OAuth.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCpG81Xa-wHu8P7s_RjzBaBg

# Used once per ingest to structure recipes and distill the voice card.
ANTHROPIC_API_KEY=
